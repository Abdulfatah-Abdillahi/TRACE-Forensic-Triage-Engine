# =============================================================================
# TRACE configuration. Copy to .env and fill in.
# Only LOCAL_LLM_URL is strictly required.
# =============================================================================

# --- Local LLM (REQUIRED) ----------------------------------------------------
# LM Studio -> load a model -> Local Server -> Start Server.
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=qwen3.5-9b-instruct
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_TEMPERATURE=0.05
LOCAL_LLM_BATCH_SIZE=10

# Set to true to run the local heuristic engine without any LLM.
MOCK_MODE=true

# --- Threat intelligence (all optional) --------------------------------------
# Each source is also toggled per-run in the UI. A source is only used when
# BOTH the key is set here AND the analyst enables it for that run.
VT_API_KEY=
METADEFENDER_API_KEY=
OTX_API_KEY=

# Free-tier rate limits. VirusTotal allows ~4 requests/minute.
VT_REQUESTS_PER_MIN=4
METADEFENDER_REQUESTS_PER_MIN=10
OTX_REQUESTS_PER_MIN=10

# How many antivirus engines must flag a hash before TRACE treats it as
# confirmed malicious (and skips the AI for that entry).
TI_CONFIRM_THRESHOLD=5
TI_CONFIRMED_SCORE=9.0

# --- Scoring weights ---------------------------------------------------------
# Renormalised at runtime over whichever components actually returned data,
# so these need not sum to 1.0.
WEIGHT_AI=0.50
WEIGHT_VT=0.30
WEIGHT_METADEFENDER=0.20

# --- Timestamps --------------------------------------------------------------
# Folder containing the EZ Tools executables (replace with your own path).
EZ_TOOLS_DIR=C:\path\to\ZimmermanTools\net9

# Eric Zimmerman's tools emit UTC, so leave this unless re-processing CSVs
# from a tool that emitted local time.
SOURCE_TIMEZONE=UTC
